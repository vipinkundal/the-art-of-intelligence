{
  "name": "the-art-of-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "A visual learning lab for advanced AI practitioners.",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run content:generate && npm run content:validate && next build --webpack",
    "start": "next dev --hostname 127.0.0.1",
    "preview": "SITE_ROOT=out node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib mdx-components.tsx",
    "content:generate": "node scripts/generate-next-content.mjs",
    "content:validate": "node scripts/validate-next-content.mjs",
    "test": "node --test scripts/visual-lab.test.mjs",
    "check": "npm run content:generate && npm run content:validate && npm run test && npm run typecheck && npm run lint",
    "audit:lessons": "node scripts/audit-lessons.mjs",
    "legacy:serve": "node scripts/serve.mjs",
    "generate:classical-ai-topics": "node scripts/generate-classical-ai-topics.mjs",
    "generate:probabilistic-ai-topics": "node scripts/generate-probabilistic-ai-topics.mjs",
    "create:lesson": "node scripts/create-lesson.mjs",
    "list:lessons": "node scripts/list-lessons.mjs",
    "serve": "next dev --hostname 127.0.0.1"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.2",
    "@phosphor-icons/react": "^2.1.10",
    "@types/mdx": "^2.0.14",
    "d3": "^7.9.0",
    "next": "^16.3.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "typescript": "^6.0.3"
  }
}
